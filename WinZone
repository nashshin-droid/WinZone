        {bets.length===0 && <p>No bets selected</p>}
        {bets.map((b,i)=><div key={i}>Game: {b.gameType} | Match: {b.match_id} | Type: {b.type} | Stake: {b.stake} | Odds: {b.odds}</div>)}
        {bets.length>0 && <button onClick={placeBets}>Place All Bets</button>}

        {/* Admin Panel */}
