        {gameType==="jackpot" && <>
          <h3>Jackpot Games</h3>
          <p>Mid-Week Jackpot (Mon–Wed, 15 games, 2M KSh prize)</p>
          <button onClick={()=>addBet({ match_id:"midweek_jackpot", odds:50 }, "midweek", "jackpot")}>Play Mid-Week Jackpot</button>

