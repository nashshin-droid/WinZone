              <p>Status: {m.status}</p>
              <button onClick={()=>addBet(m,"home")}>Home</button>
              <button onClick={()=>addBet(m,"draw")}>Draw</button>
              <button onClick={()=>addBet(m,"away")}>Away</button>
            </div>
          ))}
        </>}

        {/* Aviator */}
        {gameType==="aviator" && <>
          <h3>Aviator</h3>
          <p>Crash multiplier will be generated automatically. Cash out before it crashes!</p>
          <button onClick={()=>addBet({ match_id:"aviator1", odds:1 }, "cashout", "aviator")}>Play Aviator</button>
