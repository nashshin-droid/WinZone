        </>}

        {/* Virtual Games */}
        {gameType==="virtual" && <>
          <h3>Virtual Games</h3>
          <button onClick={()=>addBet({ match_id:"virtual1", odds:2 }, "home", "virtual")}>Home Win</button>
          <button onClick={()=>addBet({ match_id:"virtual1", odds:3 }, "draw", "virtual")}>Draw</button>
